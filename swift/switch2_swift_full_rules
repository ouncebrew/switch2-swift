#---------------------------------------------------------------------------------
# Swift support for Switch 2 programs that use the full standard library.
#
# Include this file in place of $(DEVKITPRO)/libounce/switch2_rules:
#
#   include $(DEVKITPRO)/swift/switch2_swift_full_rules
#
# It includes switch2_rules, so the C and C++ rules apply without change, and
# adds:
# - SWIFTC and SWIFTFLAGS for the full standard library.
# - A %.o: %.swift rule.
# - SWIFT_SHIM_OBJ, the object with the C runtime shims that newlib lacks.
# - SWIFT_FULL_LIBS, the Swift libraries and their C++ dependencies.
#
# A Makefile that uses Swift adds the Swift objects to OFILES_SRC,
# SWIFT_SHIM_OBJ to OFILES and SWIFT_FULL_LIBS to LIBS. See
# examples/swift-full.
#
# The libraries come from build-stdlib.sh. Without them the compiler falls back
# to the embedded standard library, which has no String.
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>devkitPro")
endif

include $(DEVKITPRO)/libounce/switch2_rules

SWIFT_HOME	?=	$(DEVKITPRO)/swift
SWIFTC		?=	$(SWIFT_HOME)/toolchain/usr/bin/swiftc

# The standard library is built for aarch64-none-none-elf, not for the
# aarch64-none-elf triple that devkitA64 uses. The two produce the same
# objects; only the triple spelling differs.
SWIFT_TARGET	:=	aarch64-none-none-elf
SWIFT_TARGET_ARCH	:=	aarch64

SWIFTFLAGS	:=	-target $(SWIFT_TARGET) -parse-as-library -O -g

SWIFT_SHIM_OBJ	:=	swift_shim.o

SWIFT_LIBDIR	:=	$(SWIFT_HOME)/toolchain/usr/lib/swift/none/$(SWIFT_TARGET_ARCH)

SWIFT_FULL_LIBS	:=	-L$(SWIFT_LIBDIR) \
			-Wl,--start-group \
			-lswift_Concurrency_swift -lswift_Concurrency \
			-lswiftCore -lswiftRuntime -lswiftDemangle \
			-lswiftLLVMSupport -lswiftStdlibStubs -lswiftThreading \
			-Wl,--end-group -lstdc++ -lm

#---------------------------------------------------------------------------------
%.o: %.swift
#---------------------------------------------------------------------------------
	@echo $(notdir $<)
	@$(SWIFTC) $(SWIFTFLAGS) -c $< -o $@

#---------------------------------------------------------------------------------
# A pattern rule, not an explicit one: an explicit target here would become the
# default goal of every Makefile that includes this file.
#---------------------------------------------------------------------------------
%.o: $(SWIFT_HOME)/%.c
#---------------------------------------------------------------------------------
	@echo $(notdir $<)
	@$(CC) -MMD -MP -MF $(DEPSDIR)/$*.d $(CPPFLAGS) $(CFLAGS) -c $< -o $@
